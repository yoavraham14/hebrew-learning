# Backend configuration — copy to backend/.env and fill in real values.
# (Frontend has its own separate env file: see frontend/.env.example.)
# No real values live in this file. See app/config.py for defaults.

# --- Database ---
# Local dev default — matches docker-compose.yml's postgres service.
DATABASE_URL=postgresql+psycopg://lingua:lingua@localhost:5432/lingua
# Cloud Run / Supabase deploys: use the Supabase POOLER connection string
# (port 6543, PgBouncer transaction mode), not the direct connection
# (port 5432) — Cloud Run's per-request/scale-to-zero connection pattern
# fits a pooler far better than one long-lived direct connection. Requires
# sslmode=require. Looks like:
#   postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# --- Auth ---
# Long random string. Rotate this and every issued token is invalidated.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=90

# One-time (or rotate-by-rerunning) PINs for the two fixed profiles,
# consumed only by `python -m app.scripts.seed_profiles`. Never logged.
HEBREW_LEARNER_PIN=
SPANISH_LEARNER_PIN=

# --- CORS ---
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# --- Gemini generation pipeline ---
# Get a free-tier key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Verify against ai.google.dev/gemini-api/docs/pricing before deploying —
# model IDs shift over time.
GEMINI_MODEL=gemini-3.6-flash

# HARD cost firewall — the app will never call Gemini past this many times
# in a day, and never asks to raise it. Raise manually, at your own
# discretion, only. See SPEC.md §2.1.
GEMINI_DAILY_CALL_CAP=200

GENERATION_BATCH_SIZE=25
TOPUP_THRESHOLD=20
TOPUP_CHECK_INTERVAL_MINUTES=15

# In-process top-up scheduler — leave true for local dev / a long-lived
# process. Cloud Run deploys MUST set this false (the container scales to
# zero and a sleeping process can't run a timer) and rely on Cloud
# Scheduler hitting POST /internal/tasks/generate-topup instead. See
# DEPLOY.md.
ENABLE_IN_PROCESS_SCHEDULER=true

# Shared secret for /internal/tasks/* (Cloud Scheduler triggers only, not
# user-facing). Leave blank for local dev — those endpoints simply reject
# everything when unset, which is fine since nothing local calls them.
# Required for a Cloud Run deploy. Generate with e.g. `openssl rand -hex 32`.
INTERNAL_TASK_SECRET=

# --- Logging ---
LOG_LEVEL=INFO

# Env files — never commit real secrets/keys
.env
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Python
backend/.venv/
backend/__pycache__/
**/__pycache__/
*.pyc
backend/.pytest_cache/
backend/*.db

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/*.tsbuildinfo

# Editors / OS
.DS_Store
.idea/
*.swp
